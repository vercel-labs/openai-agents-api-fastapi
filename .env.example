# Creates and manages the public-beta Agents API session. Keep it in FastAPI.
# Requires api.agents.read, api.agents.write, and api.responses.write.
OPENAI_API_KEY=

# Restricted key used only by codex exec-server inside Vercel Sandbox.
# Create an environment key in the Agents dashboard with other permissions set to None.
# It must be separate from OPENAI_API_KEY, with the same org, project, and owner.
OPENAI_EXECUTOR_API_KEY=

# Needed for local Sandbox calls. Use a current token for the linked Vercel project.
# Deployed Vercel applications use their project identity instead of a committed token.
VERCEL_OIDC_TOKEN=

# Optional API and model overrides. The SDK appends /agents to this API root.
AGENT_API_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5.6-sol
AGENT_REASONING_EFFORT=none
CODEX_PACKAGE=@openai/codex@alpha

# Optional sandbox policy and lifecycle limits.
SANDBOX_ALLOWED_DOMAINS=api.openai.com,codex-cloud-environments.chatgpt.com,registry.npmjs.org,github.com,api.github.com,codeload.github.com,raw.githubusercontent.com,*.githubusercontent.com
SANDBOX_TIMEOUT_MS=240000
SESSION_CREATE_TIMEOUT_SECONDS=20
SANDBOX_STARTUP_TIMEOUT_SECONDS=90
STREAM_EXECUTION_TIMEOUT_SECONDS=150
STREAM_NO_PROGRESS_TIMEOUT_SECONDS=45
EXECUTOR_HEALTHCHECK_INTERVAL_SECONDS=5
CLEANUP_TIMEOUT_SECONDS=30
ARTIFACT_MAX_BYTES=200000
